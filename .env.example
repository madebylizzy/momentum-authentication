# Database connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momentum_auth?schema=public"

# Database Configuration (for local embedded PostgreSQL runner)
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="momentum_auth"

# Node Environment
NODE_ENV="development"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Secret (Optional secret string for signing / entropy)
SESSION_SECRET="momentum_development_session_secret_replace_in_production"

# Gmail SMTP real-email delivery (verification codes + password reset links).
# Generate an App Password at https://myaccount.google.com/apppasswords (16 chars).
# Without these, email falls back to the server console.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""